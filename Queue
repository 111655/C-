#include <iostream>
using namespace std;

class Queue {
    int arr[5], front, rear;

public:
    Queue() {
        front = rear = -1;
    }

    void enqueue(int x) {
        if (rear == 4)
            cout << "Queue Overflow\n";
        else {
            if (front == -1)
                front = 0;
            arr[++rear] = x;
        }
    }

    void dequeue() {
        if (front == -1 || front > rear)
            cout << "Queue Underflow\n";
        else
            front++;
    }

    void display() {
        if (front == -1 || front > rear)
            cout << "Queue is Empty\n";
        else {
            for (int i = front; i <= rear; i++)
                cout << arr[i] << " ";
        }
    }
};

int main() {
    Queue q;
    q.enqueue(10);
    q.enqueue(20);
    q.enqueue(30);
    q.dequeue();
    q.display();
    return 0;
}
